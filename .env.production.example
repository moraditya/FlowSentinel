# NIDS Platform — Production Environment
#
# Copy to .env.prod and fill in before deploying:
#   cp .env.production.example .env.prod
#   ./deploy.sh

# Mode — production enforces strict validation
NIDS_MODE=production

# API key — REQUIRED, no default. Generate with: openssl rand -hex 16
NIDS_API_KEY=

# CORS — explicit origin, no wildcard
CORS_ORIGINS=https://your-domain.com

# Capture interface — typically eth0 on Linux
NIDS_CAPTURE_INTERFACE=eth0

# Public IP — used for browser-facing API URL
EC2_PUBLIC_IP=

# Requirements:
#   - Docker with cap_add: [NET_RAW, NET_ADMIN] for packet capture
#   - Backend runs as non-root (nids user) with setcap on python3
#   - Both containers use host networking in production
